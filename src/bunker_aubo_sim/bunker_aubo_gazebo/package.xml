<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bunker_aubo_gazebo</name>
  <version>1.1.1</version>
  <description>
    Gazebo Harmonic worlds for the BUNKER + AUBO-i5 simulation: a furnished indoor office
    with corridors, rooms, furniture and textured posters for SLAM testing.
  </description>
  <maintainer email="praddepnahak2008@gmail.com">Pradeep Nahak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
