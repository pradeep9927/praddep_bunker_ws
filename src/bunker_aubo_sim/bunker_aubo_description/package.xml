<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bunker_aubo_description</name>
  <version>1.1.1</version>
  <description>
    Modular URDF/Xacro description of the AgileX BUNKER tracked base with an AUBO-i5 arm,
    parallel gripper, IMU, VLP-16 LiDAR and two RealSense D435 cameras.
  </description>
  <maintainer email="praddepnahak2008@gmail.com">Pradeep Nahak</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>  <!-- meshes/bunker (AgileX), meshes/aubo_i5 (AUBO) -->

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
