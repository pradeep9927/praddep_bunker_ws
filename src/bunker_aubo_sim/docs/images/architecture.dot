digraph architecture {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  subgraph cluster_gz { label="Gazebo Harmonic (indoor_office.sdf)"; style="rounded"; color="#9e9e9e";
    robot [label="bunker_aubo model\nDART 1 kHz"];
    gzc [label="gz_ros2_control\ncontroller_manager 100 Hz"];
    sens [label="IMU 200 Hz | VLP-16 10 Hz\n2 x D435 RGB-D 15 Hz"];
    gt [label="OdometryPublisher\n(ground truth)"];
    robot -> gzc; robot -> sens; robot -> gt;
  }

  bridge [label="ros_gz_bridge", fillcolor="#e3f2fd"];
  ctrl [label="joint_state_broadcaster\ndiff_drive_controller\narm_controller\ngripper_controller", fillcolor="#e3f2fd"];
  rsp [label="robot_state_publisher", fillcolor="#e3f2fd"];
  ekf [label="robot_localization EKF\n(track odom + IMU)", fillcolor="#e3f2fd"];
  relay [label="base_cmd_relay\nTwist -> TwistStamped", fillcolor="#e3f2fd"];
  gas [label="gripper_action_server\nGripperCommand", fillcolor="#e3f2fd"];
  gui [label="Operator GUI\n(PyQt5 + pyqtgraph)", fillcolor="#fff8e1"];
  sync [label="rgbd_sync x2\nmulti_rgbd_sync\nlidar_self_filter", fillcolor="#e8f5e9"];
  rtab [label="RTAB-Map\ngraph SLAM", fillcolor="#e8f5e9"];
  ev [label="slam_evaluator", fillcolor="#e8f5e9"];
  maps [label="/map  /rtabmap/cloud_map\nmap.db, pgm/yaml, ply", shape=note, fillcolor="#ffffff"];
  tf [label="TF", shape=ellipse, fillcolor="#ffebee"];

  sens -> bridge [label="/imu/data /lidar/points\n/<cam>/color|depth|camera_info"];
  gt -> bridge [label="/ground_truth/odom"];
  gzc -> ctrl;
  ctrl -> rsp [label="/joint_states"];
  ctrl -> ekf [label="/odom"];
  bridge -> ekf [label="/imu/data"];
  rsp -> tf [label="robot frames"];
  ekf -> tf [label="odom -> base_footprint"];
  gui -> relay [label="/cmd_vel"];
  relay -> ctrl;
  gui -> ctrl [label="FollowJointTrajectory"];
  gui -> gas; gas -> ctrl;
  bridge -> gui [label="images, cloud, status"];
  bridge -> sync; sync -> rtab [label="RGBDImages + cloud"];
  bridge -> rtab [label="/imu/data"];
  rtab -> tf [label="map -> odom"];
  rtab -> maps;
  rtab -> ev; bridge -> ev;
}
