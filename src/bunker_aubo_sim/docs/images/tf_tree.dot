digraph tf {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  map [fillcolor="#ffebee"]; odom [fillcolor="#ffebee"];
  map -> odom [color="#c62828", label="RTAB-Map"];
  odom -> base_footprint [color="#c62828", label="EKF"];
  "base_footprint" -> "base_link" [color="#757575", style=solid, label=""];
  "base_link" -> "left_wheel_1_link" [color="#1565c0", style=bold, label="left_wheel_1_joint"];
  "base_link" -> "left_wheel_2_link" [color="#1565c0", style=bold, label="left_wheel_2_joint"];
  "base_link" -> "left_wheel_3_link" [color="#1565c0", style=bold, label="left_wheel_3_joint"];
  "base_link" -> "left_wheel_4_link" [color="#1565c0", style=bold, label="left_wheel_4_joint"];
  "base_link" -> "right_wheel_1_link" [color="#1565c0", style=bold, label="right_wheel_1_joint"];
  "base_link" -> "right_wheel_2_link" [color="#1565c0", style=bold, label="right_wheel_2_joint"];
  "base_link" -> "right_wheel_3_link" [color="#1565c0", style=bold, label="right_wheel_3_joint"];
  "base_link" -> "right_wheel_4_link" [color="#1565c0", style=bold, label="right_wheel_4_joint"];
  "base_link" -> "sensor_mast_link" [color="#757575", style=solid, label=""];
  "base_link" -> "arm_mount_link" [color="#757575", style=solid, label=""];
  "arm_mount_link" -> "aubo_base_link" [color="#757575", style=solid, label=""];
  "aubo_base_link" -> "shoulder_Link" [color="#1565c0", style=bold, label="shoulder_joint"];
  "shoulder_Link" -> "upperArm_Link" [color="#1565c0", style=bold, label="upperArm_joint"];
  "upperArm_Link" -> "foreArm_Link" [color="#1565c0", style=bold, label="foreArm_joint"];
  "foreArm_Link" -> "wrist1_Link" [color="#1565c0", style=bold, label="wrist1_joint"];
  "wrist1_Link" -> "wrist2_Link" [color="#1565c0", style=bold, label="wrist2_joint"];
  "wrist2_Link" -> "wrist3_Link" [color="#1565c0", style=bold, label="wrist3_joint"];
  "wrist3_Link" -> "tool0" [color="#757575", style=solid, label=""];
  "tool0" -> "gripper_base_link" [color="#757575", style=solid, label=""];
  "gripper_base_link" -> "gripper_left_finger_link" [color="#1565c0", style=bold, label="gripper_left_finger_joint"];
  "gripper_base_link" -> "gripper_right_finger_link" [color="#1565c0", style=bold, label="gripper_right_finger_joint"];
  "gripper_base_link" -> "gripper_tcp" [color="#757575", style=solid, label=""];
  "base_link" -> "imu_link" [color="#757575", style=solid, label=""];
  "sensor_mast_link" -> "lidar_link" [color="#757575", style=solid, label=""];
  "sensor_mast_link" -> "base_camera_link" [color="#757575", style=solid, label=""];
  "base_camera_link" -> "base_camera_color_frame" [color="#757575", style=solid, label=""];
  "base_camera_color_frame" -> "base_camera_color_optical_frame" [color="#757575", style=solid, label=""];
  "base_camera_link" -> "base_camera_depth_frame" [color="#757575", style=solid, label=""];
  "base_camera_depth_frame" -> "base_camera_depth_optical_frame" [color="#757575", style=solid, label=""];
  "tool0" -> "wrist_camera_link" [color="#757575", style=solid, label=""];
  "wrist_camera_link" -> "wrist_camera_color_frame" [color="#757575", style=solid, label=""];
  "wrist_camera_color_frame" -> "wrist_camera_color_optical_frame" [color="#757575", style=solid, label=""];
  "wrist_camera_link" -> "wrist_camera_depth_frame" [color="#757575", style=solid, label=""];
  "wrist_camera_depth_frame" -> "wrist_camera_depth_optical_frame" [color="#757575", style=solid, label=""];
  subgraph cluster_legend { label="legend"; fontsize=9; style=dashed;
    l1 [label="SLAM / EKF (runtime)", fillcolor="#ffebee"];
    l2 [label="moving joint (joint_states)", fillcolor="#e3f2fd"];
    l3 [label="fixed joint (URDF)"]; }
}
